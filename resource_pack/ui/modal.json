{
    "custom_form@common_dialogs.main_panel_no_buttons": {
        "$child_control": "modal.custom_form_panel",
        "$text_name": "#title_text",
        "$title_panel": "common_dialogs.standard_title_label",
        "$title_size": [
            "100% - 15px",
            10
        ],
        "$title_max_size": [
            "100% - 15px",
            10
        ],
        "$title_text_binding_type": "none",
        "layer": 2,
        "size": [
            225,
            200
        ]
    },
    "custom_form_panel@common.scrolling_panel": {
        "$scroll_bar_right_padding_size": [
            0,
            0
        ],
        "$scroll_size": [
            5,
            "100% - 4px"
        ],
        "$scrolling_content": "modal.custom_form_scrolling_content",
        "$scrolling_pane_offset": [
            2,
            0
        ],
        "$scrolling_pane_size": [
            "100% - 4px",
            "100% - 2px"
        ],
        "$show_background": false,
        "anchor_from": "top_left",
        "anchor_to": "top_left",
        "size": [
            "100%",
            "100%"
        ]
    },
    "custom_form_scrolling_content": {
        "type": "stack_panel",
        "anchor_from": "top_left",
        "anchor_to": "top_left",
        "offset": [
            2,
            0
        ],
        "size": [
            "100% - 4px",
            "100%c"
        ],
        "orientation": "vertical",
        "controls": [
            {
                "generated_form@modal.generated_contents": {}
            },
            {
                "submit_button@common_buttons.light_text_button": {
                    "$button_binding_condition": "once",
                    "$button_text": "#submit_text",
                    "$button_text_binding_type": "global",
                    "$pressed_button_name": "button.submit_custom_form",
                    "anchor_from": "top_left",
                    "anchor_to": "top_left",
                    "bindings": [
                        {
                            "binding_name": "#submit_button_visible",
                            "binding_name_override": "#visible"
                        }
                    ],
                    "size": [
                        "100%",
                        32
                    ]
                }
            }
        ]
    },
    "generated_contents": {
        "type": "stack_panel",
        "anchor_from": "top_left",
        "anchor_to": "top_left",
        "size": [
            "100%",
            "100%c"
        ],
        "collection_name": "custom_form",
        "factory": {
            "control_ids": {
                "slider": "@modal_component.custom_slider",
                "dropdown": "@modal_dropdown.custom_dropdown",
                "label": "@modal_component.custom_label",
                "step_slider": "@modal_component.custom_step_slider",
                "toggle": "@modal_component.custom_toggle",
                "input": "@modal_component.custom_input",
                "header": "@modal_component.custom_header",
                "divider": "@future.option_group_section_divider"
            },
            "name": "buttons"
        },
        "orientation": "vertical",
        "bindings": [
            {
                "binding_name_override": "#collection_length",
                "binding_name": "#custom_form_length"
            }
        ]
    },
    "namespace": "modal"
}