/*
user_interface/add(form_type: str) -> bool

FORM_TYPE_LONG = 0
FORM_TYPE_POPUP = 1
FORM_TYPE_MODAL = 2
*/





form_type = {func, tuple.get(args, 0)}





if form_type == 0:
  _ = {command, 'editmodalform "user_interface/add" title "return \'添加长表单\'"'}
  _ = {command, 'editlabel "user_interface/add" 0 label "return \'您正在添加一个新的长表单。\'"'}
elif form_type == 1:
  _ = {command, 'editmodalform "user_interface/add" title "return \'添加信息表单\'"'}
  _ = {command, 'editlabel "user_interface/add" 0 label "return \'您正在添加一个新的信息表单。\'"'}
elif form_type == 2:
  _ = {command, 'editmodalform "user_interface/add" title "return \'添加模态表单\'"'}
  _ = {command, 'editlabel "user_interface/add" 0 label "return \'您正在添加一个新的模态表单。\'"'}
else:
  err = 'user_interface/add: Unsupported form type; form_type = ' + str(form_type)
  _ = {func, function.panic(err)}
fi





temp = {func, slices.new(False, form_type)}
code = {func, function.call('utils/as_func_string', 'user_interface/handle_add', temp)}
_ = {command, {func, strings.format('customform onsubmit "user_interface/add" "{}"', code)}}

temp = {func, slices.new(True, form_type)}
code = {func, function.call('utils/as_func_string', 'user_interface/handle_add', temp)}
_ = {command, {func, strings.format('customform oncancel "user_interface/add" "{}"', code)}}





_ = {command, 'customform show @s ~ ~ ~ @s "user_interface/add"'}
return True