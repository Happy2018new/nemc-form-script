/*
user_interface/storage/del_form(
  form_name: str,
  form_type: int,
) -> bool

FORM_TYPE_LONG = 0
FORM_TYPE_POPUP = 1
FORM_TYPE_MODAL = 2
*/





form_name = {func, tuple.get(args, 0)}
form_type = {func, tuple.get(args, 1)}





level_id = {func, object.deref({func, world.GetLevelId()})}
storage = {func, entity.GetExtraData(level_id, 'form_ui_storage')}

if form_type == 0:
  key_ptr = {func, object.ref('long')}
elif form_type == 1:
  key_ptr = {func, object.ref('popup')}
elif form_type == 2:
  key_ptr = {func, object.ref('modal')}
else:
  err = 'user_interface/storage/del_form: Unsupported form type; form_type = ' + str(form_type)
  _ = {func, function.panic(err)}
fi





forms = {func, maps.ptr_get(storage, key_ptr)}
if {func, maps.exist(forms, form_name)}:
  _ = {func, maps.del(forms, form_name)}
fi

format = {func, json.fast_dumps(form_name)}
_ = {command, 'customform remove ' + format}

return True