/*
user_interface/storage/modal/remove_element(
  form: str,
  index: int,
) -> bool
*/



form = {func, tuple.get(args, 0)}
index = {func, tuple.get(args, 1)}



format = {func, json.fast_dumps(form)}
_ = {command, {func, strings.format('editmodalform {} sub discard {} {}', format, index, index+1)}}
_ = {command, {func, strings.format('customform save {}', format)}}



level_id = {func, object.deref({func, world.GetLevelId()})}
storage = {func, entity.GetExtraData(level_id, 'form_ui_storage')}
modal = {func, maps.ptr_get(storage, {func, object.ref('modal')})}
form_data = {func, maps.ptr_get(modal, {func, object.ref(form)})}
content = {func, maps.ptr_get(form_data, {func, object.ref('content')})}
element = {func, slices.ptr_get(content, index)}



new_content = {func, slices.new()}
for ind, {func, slices.length(content)}:
  val = {func, slices.ptr_get(content, ind)}
  if ind != index:
    _ = {func, slices.ptr_append(new_content, val)}
  fi
rof
_ = {func, maps.ptr_set(form_data, {func, object.ref('content')}, new_content)}
_ = {func, entity.SaveExtraData(level_id)}



return True