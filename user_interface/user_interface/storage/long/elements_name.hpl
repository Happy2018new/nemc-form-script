/*
user_interface/storage/long/elements_name(
  form: str,
) -> ptr@slice[tuple[button_name: str, button_icon: str]]
*/





form = {func, tuple.get(args, 0)}





level_id = {func, object.deref({func, world.GetLevelId()})}
storage = {func, entity.GetExtraData(level_id, 'form_ui_storage')}
long = {func, maps.ptr_get(storage, {func, object.ref('long')})}
form_data = {func, maps.ptr_get(long, {func, object.ref(form)})}
elements = {func, maps.ptr_get(form_data, {func, object.ref('elements')})}





result = {func, slices.new()}

for index, {func, slices.length(elements)}:
  value = {func, slices.ptr_get(elements, index)}
  element_type = {func, maps.get(value, 'type')}

  if element_type == 'button':
    name = '按钮 (' + str(index) + ')'
    icon = {func, maps.get(value, 'image')}
  elif element_type == 'label':
    name = '普通文本 (' + str(index) + ')'
    icon = ''
  elif element_type == 'header':
    name = '大字文本 (' + str(index) + ')'
    icon = ''
  elif element_type == 'divider':
    name = '分割线 (' + str(index) + ')'
    icon = ''
  else:
    err = 'user_interface/storage/long/elements_name: Unsupported long form element type; element_type = ' + element_type
    _ = {func, function.panic(err)}
  fi

  temp = {func, tuple.new(name, icon)}
  _ = {func, slices.ptr_append(result, temp)}
rof

_ = {func, object.pin(result)}
return result