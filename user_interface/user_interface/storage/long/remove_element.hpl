/*
user_interface/storage/long/remove_element(
  form: str,
  index: int,
) -> bool
*/



form = {func, tuple.get(args, 0)}
index = {func, tuple.get(args, 1)}



format = {func, json.fast_dumps(form)}
_ = {command, {func, strings.format('editlongform {} sub discard {} {}', format, index, index+1)}}
_ = {command, {func, strings.format('customform save {}', format)}}



level_id = {func, object.deref({func, world.GetLevelId()})}
storage = {func, entity.GetExtraData(level_id, 'form_ui_storage')}
long = {func, maps.ptr_get(storage, {func, object.ref('long')})}
form_data = {func, maps.ptr_get(long, {func, object.ref(form)})}
elements = {func, maps.ptr_get(form_data, {func, object.ref('elements')})}



new_elements = {func, slices.new()}
for ind, {func, slices.length(elements)}:
  if ind != index:
    val = {func, slices.ptr_get(elements, ind)}
    _ = {func, slices.ptr_append(new_elements, val)}
  fi
rof
_ = {func, maps.ptr_set(form_data, {func, object.ref('elements')}, new_elements)}
_ = {func, entity.SetExtraData(level_id, 'form_ui_storage', storage, True)}



return True