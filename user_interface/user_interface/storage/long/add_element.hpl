/*
user_interface/storage/long/add_element(
  form_name: str,
  element_type: int,
  insert_index: int,
) -> int

ELEMENT_TYPE_BUTTON = 0
ELEMENT_TYPE_LABEL = 1
ELEMENT_TYPE_HEADER = 2
ELEMENT_TYPE_DIVIDER = 3
*/





form_name = {func, tuple.get(args, 0)}
element_type = {func, tuple.get(args, 1)}
insert_index = {func, tuple.get(args, 2)}





level_id = {func, object.deref({func, world.GetLevelId()})}
storage = {func, entity.GetExtraData(level_id, 'form_ui_storage')}
long = {func, maps.ptr_get(storage, {func, object.ref('long')})}
form_data = {func, maps.ptr_get(long, {func, object.ref(form_name)})}
elements = {func, maps.ptr_get(form_data, {func, object.ref('elements')})}





map_ptr = {func, function.call('user_interface/storage/long/default_element', element_type)}
_ = {func, object.finalise(map_ptr)}

if insert_index == -1:
  insert_index = {func, slices.length(elements)}
fi

_ = {func, slices.ptr_insert(elements, insert_index, map_ptr)}
_ = {func, entity.SaveExtraData(level_id)}





format = {func, json.fast_dumps(form_name)}

if element_type == 0:
  _ = {command, {func, strings.format('editlongform {} insert {} button', format, insert_index)}}
elif element_type == 1:
  _ = {command, {func, strings.format('editlongform {} insert {} label', format, insert_index)}}
elif element_type == 2:
  _ = {command, {func, strings.format('editlongform {} insert {} header', format, insert_index)}}
elif element_type == 3:
  _ = {command, {func, strings.format('editlongform {} insert {} divider', format, insert_index)}}
else:
  err = 'user_interface/storage/long/add_element: Unsupported long form element type; element_type = ' + str(element_type)
  _ = {func, function.panic(err)}
fi

_ = {command, 'customform save ' + format}
return insert_index