/*
user_interface/long/select_texture(
  form_name: str,
  element_index: int,
) -> bool
*/



form_name = {func, tuple.get(args, 0)}
element_index = {func, tuple.get(args, 1)}



temp = {func, slices.new(False, form_name, element_index)}
code = {func, function.call('utils/as_func_string', 'user_interface/long/handle_select_texture', temp)}
_ = {command, {func, strings.format('customform onsubmit "user_interface/long/select_texture" "{}"', code)}}

temp = {func, slices.new(True, form_name, element_index)}
code = {func, function.call('utils/as_func_string', 'user_interface/long/handle_select_texture', temp)}
_ = {command, {func, strings.format('customform oncancel "user_interface/long/select_texture" "{}"', code)}}



_ = {command, 'customform show @s ~ ~ ~ @s "user_interface/long/select_texture"'}
return True