/*
user_interface/long/edit_button_panel(
  form_name: str,
  element_index: int,
) -> bool
*/



form_name = {func, tuple.get(args, 0)}
element_index = {func, tuple.get(args, 1)}




temp = {func, slices.new(False, form_name, element_index)}
code = {func, function.call('utils/as_func_string', 'user_interface/long/handle_edit_button_panel', temp)}
_ = {command, {func, strings.format('customform onsubmit "user_interface/long/edit_button_panel" "{}"', code)}}

temp = {func, slices.new(True, form_name, element_index)}
code = {func, function.call('utils/as_func_string', 'user_interface/long/handle_edit_button_panel', temp)}
_ = {command, {func, strings.format('customform oncancel "user_interface/long/edit_button_panel" "{}"', code)}}



_ = {command, 'customform show @s ~ ~ ~ @s "user_interface/long/edit_button_panel"'}
return True