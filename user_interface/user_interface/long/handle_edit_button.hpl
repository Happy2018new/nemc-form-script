/*
user_interface/long/handle_edit_button(
  is_cancel: bool,
  form_name: str,
  element_index: int,
) -> bool
*/





is_cancel = {func, tuple.get(args, 0)}
form_name = {func, tuple.get(args, 1)}
element_index = {func, tuple.get(args, 2)}





if is_cancel:
  if {ref, int, -1} != 2:
    _ = {func, function.call('user_interface/long/panel', form_name)}
  fi
  return True
fi





index = {ref, int, -1}
if index == 0:
  _ = {func, function.call('user_interface/long/edit_button_text', form_name, element_index)}
elif index == 1:
  _ = {func, function.call('user_interface/long/edit_button_icon', form_name, element_index)}
elif index == 2:
  _ = {func, function.call('user_interface/long/edit_button_cmd', form_name, element_index)}
elif index == 3:
  _ = {func, function.call('user_interface/long/panel', form_name)}
fi



return True