/*
user_interface/long/handle_select_texture(
  is_cancel: bool,
  form_name: str,
  element_index: int,
) -> bool

callback(
  submit_type: int,
  options: ptr@slice[text: str | tuple[text: str, icon: str, ...]],
  extra: ptr@map
  selected: int,
) -> int | bool | float | str

SUBMIT_TYPE_SUBMIT = 1
SUBMIT_TYPE_BACK = 2
SUBMIT_TYPE_CANCEL = 3
*/





is_cancel = {func, tuple.get(args, 0)}
form_name = {func, tuple.get(args, 1)}
element_index = {func, tuple.get(args, 2)}





if is_cancel:
  if {ref, int, -1} != 2:
    // back to a long form that used to edit this button
  fi
  return True
fi





keyword = {ref, str, 1}
direct = {ref, bool, 2}

if direct:
  _ = {func, function.call('user_interface/storage/long/update_button_image', form_name, element_index, keyword)}
  // back to a long form that used to edit this button
else:
  result = {func, utils.texture_by_keyword(keyword, True)}
  extra = {func, maps.new(False, 'form_name', form_name, 'element_index', element_index)}
  _ = {func, function.call('page_split/select_panel', '为按钮选择材质贴图', '请从中选择一个作为按钮的贴图。', result, extra, 1, 'user_interface/long/select_texture_callback')}
fi

return True