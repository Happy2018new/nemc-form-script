/*
user_interface/long/edit_button_icon_callback(
  submit_type: int,
  options: ptr@slice[text: str | tuple[text: str, icon: str, ...]],
  extra: ptr@map
  selected: int,
) -> bool

SUBMIT_TYPE_SUBMIT = 1
SUBMIT_TYPE_BACK = 2
SUBMIT_TYPE_CANCEL = 3
*/



submit_type = {func, tuple.get(args, 0)}
options = {func, tuple.get(args, 1)}
extra = {func, tuple.get(args, 2)}
selected = {func, tuple.get(args, 3)}



form_name = {func, maps.get(extra, 'form_name')}
element_index = {func, maps.get(extra, 'element_index')}



if submit_type == 1:
  texture_id = {func, slices.ptr_get(options, selected)}
  texture_id = {func, tuple.get(texture_id, 1)}
  _ = {func, function.call('user_interface/long/update_button_image', form_name, element_index, texture_id)}
  _ = {func, function.call('user_interface/long/edit_button', form_name, element_index)}
elif submit_type == 2:
  _ = {func, function.call('user_interface/long/edit_button_icon', form_name, element_index)}
elif submit_type == 3:
  if {ref, int, -1} != 2:
    _ = {func, function.call('user_interface/long/edit_button_icon', form_name, element_index)}
  fi
fi



return True