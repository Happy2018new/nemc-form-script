/*
user_interface/long/edit_button_icon(
  form_name: str,
  element_index: int,
) -> bool
*/



form_name = {func, tuple.get(args, 0)}
element_index = {func, tuple.get(args, 1)}



level_id = {func, object.deref({func, world.GetLevelId()})}
storage = {func, entity.GetExtraData(level_id, 'form_ui_storage')}
long = {func, maps.ptr_get(storage, {func, object.ref('long')})}
form_data = {func, maps.ptr_get(long, {func, object.ref(form_name)})}
elements = {func, maps.ptr_get(form_data, {func, object.ref('elements')})}
element = {func, slices.ptr_get(elements, element_index)}



texture = {func, maps.get(element, 'image')}
texture = {func, function.call('utils/as_code_string', texture)}
cmd = {func, strings.format('editinput "user_interface/long/edit_button_icon" 1 default "return {}"', texture)}
_ = {command, cmd}



temp = {func, slices.new(False, form_name, element_index)}
code = {func, function.call('utils/as_func_string', 'user_interface/long/handle_edit_button_icon', temp)}
_ = {command, {func, strings.format('customform onsubmit "user_interface/long/edit_button_icon" "{}"', code)}}

temp = {func, slices.new(True, form_name, element_index)}
code = {func, function.call('utils/as_func_string', 'user_interface/long/handle_edit_button_icon', temp)}
_ = {command, {func, strings.format('customform oncancel "user_interface/long/edit_button_icon" "{}"', code)}}



_ = {command, 'customform show @s ~ ~ ~ @s "user_interface/long/edit_button_icon"'}
return True