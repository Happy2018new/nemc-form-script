// user_interface/long/panel(form: str) -> bool



form = {func, tuple.get(args, 0)}



temp = {func, strings.format('您目前正在操作长表单“{}”。\n请选择您要进行的操作。', form)}
code = {func, function.call('utils/as_code_string', temp)}
_ = {command, {func, strings.format('editlongform "user_interface/long/panel" content "{}"', code)}}

temp = {func, slices.new(False, form)}
code = {func, function.call('utils/as_func_string', 'user_interface/long/handle_panel', temp)}
_ = {command, {func, strings.format('customform onsubmit "user_interface/long/panel" "{}"', code)}}

temp = {func, slices.new(True, form)}
code = {func, function.call('utils/as_func_string', 'user_interface/long/handle_panel', temp)}
_ = {command, {func, strings.format('customform oncancel "user_interface/long/panel" "{}"', code)}}



_ = {command, 'customform show @s ~ ~ ~ @s "user_interface/long/panel"'}
return True