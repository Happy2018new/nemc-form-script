/*
user_interface/long/update_button_image(
  form_name: str,
  element_index: int,
  texture_id: str,
) -> bool
*/



form_name = {func, tuple.get(args, 0)}
element_index = {func, tuple.get(args, 1)}
texture_id = {func, tuple.get(args, 2)}



format = {func, json.fast_dumps(form_name)}
code = {func, function.call('utils/as_code_string', texture_id)}
_ = {command, {func, strings.format('editbutton {} {} icon "return {}"', format, element_index, code)}}
_ = {command, {func, strings.format('customform save {}', format)}}



_ = {func, function.call('user_interface/storage/long/update_button_image', form_name, element_index, texture_id)}
return True