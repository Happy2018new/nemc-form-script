/*
user_interface/long/preview(form: str) -> bool

FORM_TYPE_LONG = 0
FORM_TYPE_POPUP = 1
FORM_TYPE_MODAL = 2
*/



form = {func, tuple.get(args, 0)}
format = {func, json.fast_dumps(form)}



level_id = {func, object.deref({func, world.GetLevelId()})}
storage = {func, entity.GetExtraData(level_id, 'form_ui_storage')}
long = {func, maps.ptr_get(storage, {func, object.ref('long')})}
form_data = {func, maps.ptr_get(long, {func, object.ref(form)})}
elements = {func, maps.ptr_get(form_data, {func, object.ref('elements')})}
oncancel = {func, maps.ptr_get(form_data, {func, object.ref('oncancel')})}



_ = {func, function.call('user_interface/long/process_submit', form, elements, True)}
_ = {func, function.call('user_interface/process_cancel', form, 0, oncancel, True)}
_ = {command, {func, strings.format('customform show @s ~ ~ ~ @s {}', format)}}
_ = {func, function.call('user_interface/long/process_submit', form, elements, False)}
_ = {func, function.call('user_interface/process_cancel', form, 0, oncancel, False)}



return True