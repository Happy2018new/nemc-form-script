/*
user_interface/long/process_submit(
  form_name: str,
  elements: ptr@slice[map[str, Any]],
  is_debug: bool,
) -> bool
*/





form_name = {func, tuple.get(args, 0)}
elements = {func, tuple.get(args, 1)}
is_debug = {func, tuple.get(args, 2)}





result = 'cond = False | '
result = result + 'index = {ref, int, -1} | '
button_count = -1
onclick_ptr = {func, object.ref('onclick')}



for index, {func, slices.length(elements)}:
  value = {func, slices.ptr_get(elements, index)}
  if {func, maps.get(value, 'type')} != 'button':
    continue
  else:
    button_count = button_count + 1
  fi



  onclick = {func, maps.ptr_get(value, onclick_ptr)}
  length = {func, slices.length(onclick)}
  if length == 0:
    continue
  else:
    result = result + 'if index == '
    result = result + str(button_count)
    result = result + ': | '
  fi




  for ind, length:
    val = {func, slices.ptr_get(onclick, ind)}
    condition = {func, maps.get(val, 'condition')}
    payload = {func, maps.get(val, 'payload')}

    temp = '{command, '
    temp = temp + {func, function.call('utils/as_code_string', payload)}
    temp = temp + '} > 0'

    if condition:
      result = result + {func, strings.format('if cond: | cond = {} | fi | ', temp)}
    else:
      result = result + {func, strings.format('cond = {} | ', temp)}
    fi
  rof



  result = result + 'fi | '
rof



if is_debug:
  temp = {func, slices.new(form_name)}
  temp = {func, function.call('utils/as_func_string', 'user_interface/long/panel', temp)}
  temp = {func, strings.sub(temp, 7, {func, strings.length(temp)})}
  result = result + {func, strings.format('_ = {} | ', temp)}
fi





result = {func, strings.strip(result)}
result = {func, strings.rstrip(result, '|')}
format = {func, json.fast_dumps(form_name)}

_ = {command, {func, strings.format('customform onsubmit {} "{}"', format, result)}}
_ = {command, {func, strings.format('customform save {}', format)}}

return True