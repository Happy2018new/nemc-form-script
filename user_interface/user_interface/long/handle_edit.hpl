/*
user_interface/long/handle_edit(
  is_cancel: bool,
  form: str,
  length: int,
) -> bool
*/



is_cancel = {func, tuple.get(args, 0)}
form = {func, tuple.get(args, 1)}
length = {func, tuple.get(args, 2)}



if is_cancel:
  if {ref, int, -1} != 2:
    _ = {func, function.call('user_interface/long/panel', form)}
  fi
  return True
fi



index = {ref, int, -1}
if index == length:
  _ = {func, function.call('user_interface/long/panel', form)}
  return True
fi



level_id = {func, object.deref({func, world.GetLevelId()})}
storage = {func, entity.GetExtraData(level_id, 'form_ui_storage')}
long = {func, maps.ptr_get(storage, {func, object.ref('long')})}
form_data = {func, maps.ptr_get(long, {func, object.ref(form)})}
elements = {func, maps.ptr_get(form_data, {func, object.ref('elements')})}

element = {func, slices.ptr_get(elements, index)}
element_type = {func, maps.get(element, 'type')}
if element_type == 'button':
  _ = {func, function.call('user_interface/long/edit_button', form, index)}
elif element_type == 'label' or element_type == 'header':
  _ = {func, function.call('user_interface/long/edit_text', form, index)}
elif element_type == 'divider':
  _ = {func, function.call('user_interface/long/edit_divider', form)}
else:
  err = 'user_interface/long/handle_edit: Unsupported element type; element_type = ' + element_type
  _ = {func, function.panic(err)}
fi

return True