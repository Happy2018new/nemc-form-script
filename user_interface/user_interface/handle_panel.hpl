/*
user_interface/handle_panel(is_cancel: bool) -> bool

EDIT_TYPE_ADD_FORM = 0
EDIT_TYPE_EDIT_FORM = 1
EDIT_TYPE_REMOVE_FORM = 2
*/



is_cancel = {func, tuple.get(args, 0)}



if is_cancel:
  if {ref, int,-1} != 2:
    _ = {command, 'title @s title @s 再见！'}
    _ = {command, 'title @s subtitle 期待下次与您相会！'}
  fi
  return True
fi



index = {ref, int, -1}
if index == 0:
  _ = {func, function.call('user_interface/pivot', 0)}
elif index == 1:
  _ = {func, function.call('user_interface/pivot', 1)}
elif index == 2:
  _ = {func, function.call('user_interface/pivot', 2)}
elif index == 3:
  _ = {func, function.call('user_interface/help')}
elif index == 4:
  _ = {command, 'title @s title @s 再见！'}
  _ = {command, 'title @s subtitle 期待下次与您相会！'}
fi



return True