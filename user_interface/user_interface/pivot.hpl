/*
user_interface/pivot(edit_type: int) -> bool

EDIT_TYPE_ADD_FORM = 0
EDIT_TYPE_EDIT_FORM = 1
EDIT_TYPE_REMOVE_FORM = 2
*/



edit_type = {func, tuple.get(args, 0)}



temp = {func, slices.new(False, edit_type)}
code = {func, function.call('utils/as_func_string', 'user_interface/handle_pivot', temp)}
_ = {command, {func, strings.format('customform onsubmit "user_interface/pivot" "{}"', code)}}

temp = {func, slices.new(True, edit_type)}
code = {func, function.call('utils/as_func_string', 'user_interface/handle_pivot', temp)}
_ = {command, {func, strings.format('customform oncancel "user_interface/pivot" "{}"', code)}}



_ = {command, 'customform show @s ~ ~ ~ @s "user_interface/pivot"'}
return True