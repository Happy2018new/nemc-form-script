/*
user_interface/handle_cancel_specific(
  is_cancel: bool,
  form_name: str,
  form_type: str,
  edit_type: int,
  command_length: int,
) -> bool

FORM_TYPE_LONG = 0
FORM_TYPE_POPUP = 1
FORM_TYPE_MODAL = 2

EDIT_TYPE_EDIT_NORMAL_CANCEL = 0
EDIT_TYPE_EDIT_BUSY_CANCEL = 1
EDIT_TYPE_EDIT_EXIT_CANCEL = 2
*/





is_cancel = {func, tuple.get(args, 0)}
form_name = {func, tuple.get(args, 1)}
form_type = {func, tuple.get(args, 2)}
edit_type = {func, tuple.get(args, 3)}
command_length = {func, tuple.get(args, 4)}





if is_cancel:
  if {ref, int, -1} != 2:
    _ = {func, function.call('user_interface/cancel', form_name, form_type)}
  fi
  return True
fi





commands = {func, slices.new()}

if edit_type == 0:
  start = 4
elif edit_type == 1:
  start = 5
elif edit_type == 2:
  start = 5
else:
  err = 'user_interface/handle_cancel_specific: Unsupported edit type; edit_type = ' + str(edit_type)
  _ = {func, function.panic(err)}
fi

for i, command_length:
  payload = {ref, str, start+2*i}
  condition = {ref, bool, start+1+2*i}

  if {func, strings.length(payload)} == 0:
    continue
  fi

  ptr = {func, maps.new(False, 'condition', condition, 'payload', payload)}
  _ = {func, slices.ptr_append(commands, ptr)}
rof





level_id = {func, object.deref({func, world.GetLevelId()})}
storage = {func, entity.GetExtraData(level_id, 'form_ui_storage')}

if form_type == 0:
  key_ptr = {func, object.ref('long')}
elif form_type == 1:
  key_ptr = {func, object.ref('popup')}
elif form_type == 2:
  key_ptr = {func, object.ref('modal')}
else:
  err = 'user_interface/handle_cancel_specific: Unsupported form type; form_type = ' + str(form_type)
  _ = {func, function.panic(err)}
fi

forms = {func, maps.ptr_get(storage, key_ptr)}
form_data = {func, maps.ptr_get(forms, {func, object.ref(form_name)})}
oncancel = {func, maps.ptr_get(form_data, {func, object.ref('oncancel')})}

if edit_type == 0:
  key_ptr = {func, object.ref('normal')}
elif edit_type == 1:
  key_ptr = {func, object.ref('busy')}
elif edit_type == 2:
  key_ptr = {func, object.ref('exit')}
else:
  err = 'user_interface/handle_cancel_specific: Unsupported edit type; edit_type = ' + str(edit_type)
  _ = {func, function.panic(err)}
fi

_ = {func, maps.ptr_set(oncancel, key_ptr, commands)}
_ = {func, entity.SaveExtraData(level_id)}





_ = {func, function.call('user_interface/process_cancel', form_name, form_type, oncancel, False)}
_ = {func, function.call('user_interface/cancel', form_name, form_type)}
return True