/*
user_interface/popup/handle_button2(
  is_cancel: bool,
  form_name: str,
  command_length: int,
) -> bool
*/





is_cancel = {func, tuple.get(args, 0)}
form_name = {func, tuple.get(args, 1)}
format = {func, json.fast_dumps(form_name)}
command_length = {func, tuple.get(args, 2)}





if is_cancel:
  if {ref, int, -1} != 2:
    _ = {func, function.call('user_interface/popup/panel', form_name)}
  fi
  return True
fi





level_id = {func, object.deref({func, world.GetLevelId()})}
storage = {func, entity.GetExtraData(level_id, 'form_ui_storage')}
popup = {func, maps.ptr_get(storage, {func, object.ref('popup')})}
form_data = {func, maps.ptr_get(popup, {func, object.ref(form_name)})}
button = {func, maps.ptr_get(form_data, {func, object.ref('button2')})}





text = {ref, str, 3}
_ = {func, maps.set(button, 'text', text)}

result = {func, function.try('utils/compile_code', text)}
code = {func, tuple.get(result, 0)}
err = {func, tuple.get(result, 1)}
if {func, strings.length(err)} > 0:
  code = {func, function.call('utils/as_code_string', '§c文本存在语法错误')}
fi

cmd = {func, strings.format('editpopupform {} button2 "return {}"', format, code)}
_ = {command, cmd}





commands = {func, slices.new()}

for i, command_length:
  payload = {ref, str, 8+2*i}
  condition = {ref, bool, 9+2*i}

  if {func, strings.length(payload)} == 0:
    continue
  fi

  ptr = {func, maps.new(False, 'condition', condition, 'payload', payload)}
  _ = {func, slices.ptr_append(commands, ptr)}
rof

key_ptr = {func, object.ref('onclick')}
_ = {func, maps.ptr_set(button, key_ptr, commands)}
_ = {func, entity.SetExtraData(level_id, 'form_ui_storage', storage, True)}





_ = {func, function.call('user_interface/popup/process_submit', form_name, False)}
_ = {func, function.call('user_interface/popup/panel', form_name)}
return True