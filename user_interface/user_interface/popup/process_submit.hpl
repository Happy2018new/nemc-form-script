/*
user_interface/popup/process_submit(
  form_name: str,
  is_debug: bool,
) -> bool
*/







form_name = {func, tuple.get(args, 0)}
is_debug = {func, tuple.get(args, 1)}







level_id = {func, object.deref({func, world.GetLevelId()})}
storage = {func, entity.GetExtraData(level_id, 'form_ui_storage')}
popup = {func, maps.ptr_get(storage, {func, object.ref('popup')})}
form_data = {func, maps.ptr_get(popup, {func, object.ref(form_name)})}
button1 = {func, maps.ptr_set(form_data, {func, object.ref('button1')})}
button2 = {func, maps.ptr_set(form_data, {func, object.ref('button2')})}







result = 'cond = False | '
result = result + 'if {ref, bool, -1}: | '
click_ptr = {func, object.ref('onclick')}



onclick = {func, maps.ptr_get(button1, click_ptr)}
result = {func, function.call('user_interface/popup/submit_helper', result, onclick)}

result = result + 'else: | '
onclick = {func, maps.ptr_get(button2, click_ptr)}
result = {func, function.call('user_interface/popup/submit_helper', result, onclick)}

result = result + 'fi | '



if is_debug:
  temp = {func, slices.new(form_name)}
  temp = {func, function.call('utils/as_func_string', 'user_interface/popup/panel', temp)}
  temp = {func, strings.sub(temp, 7, {func, strings.length(temp)})}
  result = result + {func, strings.format('_ = {} | ', temp)}
fi







result = {func, strings.strip(result)}
result = {func, strings.rstrip(result, '|')}
format = {func, json.fast_dumps(form_name)}

_ = {command, {func, strings.format('customform onsubmit {} "{}"', format, result)}}
_ = {command, {func, strings.format('customform save {}', format)}}

return True