/*
user_interface/popup/button1(form: str) -> bool
*/





form = {func, tuple.get(args, 0)}





level_id = {func, object.deref({func, world.GetLevelId()})}
storage = {func, entity.GetExtraData(level_id, 'form_ui_storage')}
popup = {func, maps.ptr_get(storage, {func, object.ref('popup')})}
form_data = {func, maps.ptr_get(popup, {func, object.ref(form)})}
button = {func, maps.ptr_get(form_data, {func, object.ref('button1')})}





text = {func, maps.get(button, 'text')}
text = {func, function.call('utils/as_code_string', text)}
cmd = {func, strings.format('editinput "user_interface/popup/button1" 3 default "return {}"', text)}
_ = {command, cmd}





length = {func, form.modal_form_length('user_interface/popup/button1')}
_ = {command, 'editmodalform "user_interface/popup/button1" sub discard 8 ' + str(length)}

onclick = {func, maps.ptr_get(button, {func, object.ref('onclick')})}
length = {func, slices.length(onclick)}

if {func, math.mod(length, 3)} == 0:
  final = length + 3
else:
  final = 3*int(length/3) + 3
fi

for i, final:
  _ = {command, 'editmodalform "user_interface/popup/button1" append input'}
  _ = {command, 'editmodalform "user_interface/popup/button1" append toggle'}

  _ = {command, {func, strings.format('editinput "user_interface/popup/button1" {} text "return \'要执行的指令\'"', 8+2*i)}}
  _ = {command, {func, strings.format('edittoggle "user_interface/popup/button1" {} text "return \'条件制约\'"', 9+2*i)}}
  _ = {command, {func, strings.format('edittoggle "user_interface/popup/button1" {} tooltip "return \'要求该指令只会在上一个指令成功时才执行。\'"', 9+2*i)}}

  if i < length:
    ptr = {func, slices.ptr_get(onclick, i)}

    payload = {func, maps.get(ptr, 'payload')}
    payload = {func, function.call('utils/as_code_string', payload)}
    _ = {command, {func, strings.format('editinput "user_interface/popup/button1" {} default "return {}"', 8+2*i, payload)}}

    condition = {func, maps.get(ptr, 'condition')}
    if condition:
      _ = {command, {func, strings.format('edittoggle "user_interface/popup/button1" {} default "return True"', 9+2*i)}}
    fi
  fi
rof





temp = {func, slices.new(False, form, final)}
code = {func, function.call('utils/as_func_string', 'user_interface/popup/handle_button1', temp)}
_ = {command, {func, strings.format('customform onsubmit "user_interface/popup/button1" "{}"', code)}}

temp = {func, slices.new(True, form, final)}
code = {func, function.call('utils/as_func_string', 'user_interface/popup/handle_button1', temp)}
_ = {command, {func, strings.format('customform oncancel "user_interface/popup/button1" "{}"', code)}}





_ = {command, 'customform show @s ~ ~ ~ @s "user_interface/popup/button1"'}
return True