/*
user_interface/popup/submit_helper(
  result: str,
  onclick: ptr@slice[map[str, Any]],
) -> bool
*/



result = {func, tuple.get(args, 0)}
onclick = {func, tuple.get(args, 1)}



for index, {func, slices.length(onclick)}:
  value = {func, slices.ptr_get(onclick, index)}
  condition = {func, maps.get(value, 'condition')}
  payload = {func, maps.get(value, 'payload')}

  temp = '{command, '
  temp = temp + {func, function.call('utils/as_code_string', payload)}
  temp = temp + '} > 0'

  if condition:
    result = result + {func, strings.format('if cond: | cond = {} | fi | ', temp)}
  else:
    result = result + {func, strings.format('cond = {} | ', temp)}
  fi
rof



return result