// user_interface/popup/text(form_name: str) -> bool





form_name = {func, tuple.get(args, 0)}





level_id = {func, object.deref({func, world.GetLevelId()})}
storage = {func, entity.GetExtraData(level_id, 'form_ui_storage')}
popup = {func, maps.ptr_get(storage, {func, object.ref('popup')})}
form_data = {func, maps.ptr_get(popup, {func, object.ref(form_name)})}





text = {func, maps.get(form_data, 'title')}
text = {func, function.call('utils/as_code_string', text)}
cmd = {func, strings.format('editinput "user_interface/popup/text" 2 default "return {}"', text)}
_ = {command, cmd}



text = {func, maps.get(form_data, 'content')}
text = {func, function.call('utils/as_code_string', text)}
cmd = {func, strings.format('editinput "user_interface/popup/text" 5 default "return {}"', text)}
_ = {command, cmd}





temp = {func, slices.new(False, form_name)}
code = {func, function.call('utils/as_func_string', 'user_interface/popup/handle_text', temp)}
_ = {command, {func, strings.format('customform onsubmit "user_interface/popup/text" "{}"', code)}}

temp = {func, slices.new(True, form_name)}
code = {func, function.call('utils/as_func_string', 'user_interface/popup/handle_text', temp)}
_ = {command, {func, strings.format('customform oncancel "user_interface/popup/text" "{}"', code)}}





_ = {command, 'customform show @s ~ ~ ~ @s "user_interface/popup/text"'}
return True