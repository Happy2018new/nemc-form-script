/*
user_interface/edit_callback(
  submit_type: int,
  options: ptr@slice[text: str | tuple[text: str, icon: str, ...]],
  extra: ptr@map
  selected: int,
) -> bool

FORM_TYPE_LONG = 0
FORM_TYPE_POPUP = 1
FORM_TYPE_MODAL = 2

SUBMIT_TYPE_SUBMIT = 1
SUBMIT_TYPE_BACK = 2
SUBMIT_TYPE_CANCEL = 3
*/



submit_type = {func, tuple.get(args, 0)}
options = {func, tuple.get(args, 1)}
extra = {func, tuple.get(args, 2)}
selected = {func, tuple.get(args, 3)}



if submit_type == 1:
  form_type = {func, maps.get(extra, 'form_type')}
  form_name = {func, slices.get(options, selected)}
  if form_type == 0:
    _ = {func, function.call('user_interface/long/panel', form_name)}
  elif form_type == 1:
    _ = {func, function.call('user_interface/popup/panel', form_name)}
  elif form_type == 2:
    _ = {func, function.call('user_interface/modal/panel', form_name)}
  else:
    err = 'user_interface/edit_callback: Unsupported form type; form_type = ' + str(form_type)
    _ = {func, function.panic(err)}
  fi
elif submit_type == 2:
  _ = {func, function.call('user_interface/panel')}
elif submit_type == 3:
  if {ref, int, -1} != 2:
    _ = {func, function.call('user_interface/panel')}
  fi
fi



return True