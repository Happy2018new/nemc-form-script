/*
user_interface/modal/edit_text(
  form_name: str,
  element_index: int,
) -> bool
*/



form_name = {func, tuple.get(args, 0)}
element_index = {func, tuple.get(args, 1)}



level_id = {func, object.deref({func, world.GetLevelId()})}
storage = {func, entity.GetExtraData(level_id, 'form_ui_storage')}
modal = {func, maps.ptr_get(storage, {func, object.ref('modal')})}
form_data = {func, maps.ptr_get(modal, {func, object.ref(form_name)})}
content = {func, maps.ptr_get(form_data, {func, object.ref('content')})}
element = {func, slices.ptr_get(content, element_index)}



text = {func, maps.get(element, 'text')}
text = {func, function.call('utils/as_code_string', text)}

cmd = {func, strings.format('editinput "user_interface/modal/edit_text" 1 default "return {}"', text)}
_ = {command, cmd}

temp = {func, slices.new(False, form_name, element_index)}
code = {func, function.call('utils/as_func_string', 'user_interface/modal/handle_edit_text', temp)}
_ = {command, {func, strings.format('customform onsubmit "user_interface/modal/edit_text" "{}"', code)}}

temp = {func, slices.new(True, form_name, element_index)}
code = {func, function.call('utils/as_func_string', 'user_interface/modal/handle_edit_text', temp)}
_ = {command, {func, strings.format('customform oncancel "user_interface/modal/edit_text" "{}"', code)}}



_ = {command, 'customform show @s ~ ~ ~ @s "user_interface/modal/edit_text"'}
return True