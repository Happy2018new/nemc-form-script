/*
user_interface/modal/handle_add_after(
  is_cancel: bool,
  form: str,
  index: int,
) -> bool
*/



is_cancel = {func, tuple.get(args, 0)}
form = {func, tuple.get(args, 1)}
index = {func, tuple.get(args, 2)}



if is_cancel:
  if {ref, int, -1} != 2:
    if index == -1:
      _ = {func, function.call('user_interface/modal/add', form)}
    else:
      _ = {func, function.call('user_interface/modal/insert', form)}
    fi
  fi
  return True
fi



if {ref, bool, 0}:
  if index == -1:
    _ = {func, function.call('user_interface/modal/add', form, -1)}
  else:
    _ = {func, function.call('user_interface/modal/insert', form)}
  fi
  return True
fi



level_id = {func, object.deref({func, world.GetLevelId()})}
storage = {func, entity.GetExtraData(level_id, 'form_ui_storage')}
modal = {func, maps.ptr_get(storage, {func, object.ref('modal')})}
form_data = {func, maps.ptr_get(modal, {func, object.ref(form)})}
content = {func, maps.ptr_get(form_data, {func, object.ref('content')})}

if index == -1:
  index = {func, slices.length(content)} - 1
fi
element = {func, slices.ptr_get(content, index)}
element_type = {func, maps.get(element, 'type')}

if element_type == 'label' or element_type == 'header':
  _ = {func, function.call('user_interface/modal/edit_text', form, index)}
elif element_type == 'divider':
  _ = {func, function.panic('unreachable')}
elif element_type == 'input':
  _ = {func, function.call('user_interface/modal/edit_input', form, index)}
elif element_type == 'toggle':
  _ = {func, function.call('user_interface/modal/edit_toggle', form, index)}
elif element_type == 'dropdown':
  _ = {func, function.call('user_interface/modal/edit_dropdown', form, index)}
elif element_type == 'slider':
  _ = {func, function.call('user_interface/modal/edit_slider', form, index)}
elif element_type == 'step_slider':
  _ = {func, function.call('user_interface/modal/edit_step_slider', form, index)}
else:
  err = 'user_interface/modal/handle_add_after: Unsupported element type; element_type = ' + element_type
  _ = {func, function.panic(err)}
fi



return True