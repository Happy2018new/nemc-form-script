/*
user_interface/modal/handle_edit_slider(
  is_cancel: bool,
  form_name: str,
  element_index: int,
  command_length: int,
) -> bool

ENUM_TO_INT = 0
ENUM_TO_BOOL = 1
ENUM_TO_FLOAT = 2
ENUM_TO_STR = 3
*/





is_cancel = {func, tuple.get(args, 0)}
form_name = {func, tuple.get(args, 1)}
format = {func, json.fast_dumps(form_name)}
element_index = {func, tuple.get(args, 2)}
command_length = {func, tuple.get(args, 3)}





if is_cancel:
  if {ref, int, -1} != 2:
    _ = {func, function.call('user_interface/modal/edit', form_name)}
  fi
  return True
fi





level_id = {func, object.deref({func, world.GetLevelId()})}
storage = {func, entity.GetExtraData(level_id, 'form_ui_storage')}
modal = {func, maps.ptr_get(storage, {func, object.ref('modal')})}
form_data = {func, maps.ptr_get(modal, {func, object.ref(form_name)})}
content = {func, maps.ptr_get(form_data, {func, object.ref('content')})}
element = {func, slices.ptr_get(content, element_index)}





text = {ref, str, 2}
_ = {func, maps.set(element, 'text', text)}

result = {func, function.try('utils/compile_code', text)}
code = {func, tuple.get(result, 0)}
err = {func, tuple.get(result, 1)}
if {func, strings.length(err)} > 0:
  code = {func, function.call('utils/as_code_string', '§c文本存在语法错误')}
fi

cmd = {func, strings.format('editslider {} {} text "return {}"', format, element_index, code)}
_ = {command, cmd}



min = {ref, str, 6}
min = {func, function.call('utils/safe_cast', min, 0)}
max = {ref, str, 7}
max = {func, function.call('utils/safe_cast', max, 0)}
step = {ref, str, 8}
step = {func, function.call('utils/safe_cast', step, 0)}

if min == max:
  max = min + 1
fi
if min > max:
  temp = min
  min = max
  max = temp
fi
if step <= 0:
  step = 1
fi

_ = {func, maps.set(element, 'min', min)}
_ = {func, maps.set(element, 'max', max)}
_ = {func, maps.set(element, 'step', step)}

_ = {command, {func, strings.format('editslider {} {} min "return {}"', format, element_index, min)}}
_ = {command, {func, strings.format('editslider {} {} max "return {}"', format, element_index, max)}}
_ = {command, {func, strings.format('editslider {} {} step "return {}"', format, element_index, step)}}



default = {ref, str, 12}
_ = {func, maps.set(element, 'default', default)}

result = {func, function.try('utils/compile_code', default)}
code = {func, tuple.get(result, 0)}
err = {func, tuple.get(result, 1)}
if {func, strings.length(err)} > 0:
  code = {func, function.call('utils/as_code_string', str(min))}
fi

temp = {func, strings.format('temp = {} | ', code)}
temp = temp + 'temp = {func, function.call(\'utils/safe_cast\', temp, 0)} | '
temp = temp + {func, strings.format('if temp < {}: | return {} | fi | ', min, min)}
temp = temp + {func, strings.format('if temp > {}: | return {} | fi | ', max, max)}
temp = temp + 'return temp'

cmd = {func, strings.format('editslider {} {} default "{}"', format, element_index, temp)}
_ = {command, cmd}



condition = {ref, str, 15}
payload = {ref, str, 16}

key_ptr = {func, object.ref('optional_tooltip')}
_ = {func, maps.ptr_set(element, key_ptr, {func, maps.new(False, 'condition', condition, 'payload', payload)})}

result = {func, function.try('utils/compile_code', payload)}
code = {func, tuple.get(result, 0)}
err = {func, tuple.get(result, 1)}
if {func, strings.length(err)} > 0:
  code = {func, function.call('utils/as_code_string', '§c文本存在语法错误')}
fi

temp = {func, function.call('utils/as_code_string', condition)}
temp = temp + '== \'\' or ' + '{command, ' + temp + '} > 0:'
cmd = {func, strings.format('editslider {} {} tooltip "if {} | return {} | else: | return \'\' | fi"', format, element_index, temp, code)}
_ = {command, cmd}





commands = {func, slices.new()}

for i, command_length:
  payload = {ref, str, 21+2*i}
  condition = {ref, bool, 22+2*i}

  if {func, strings.length(payload)} == 0:
    continue
  fi

  ptr = {func, maps.new(False, 'condition', condition, 'payload', payload)}
  _ = {func, slices.ptr_append(commands, ptr)}
rof

key_ptr = {func, object.ref('onsubmit')}
_ = {func, maps.ptr_set(element, key_ptr, commands)}
_ = {func, entity.SaveExtraData(level_id)}





_ = {func, function.call('user_interface/modal/process_submit', form_name, content, False)}
_ = {func, function.call('user_interface/modal/edit', form_name)}
return True