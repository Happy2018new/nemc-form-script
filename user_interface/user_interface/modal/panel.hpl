// user_interface/modal/panel(form: str) -> bool



form = {func, tuple.get(args, 0)}



temp = {func, strings.format('您目前正在操作模态表单“{}”。\n请选择您要进行的操作。', form)}
code = {func, function.call('utils/as_code_string', temp)}
_ = {command, {func, strings.format('editlongform "user_interface/modal/panel" content "{}"', code)}}

temp = {func, slices.new(False, form)}
code = {func, function.call('utils/as_func_string', 'user_interface/modal/handle_panel', temp)}
_ = {command, {func, strings.format('customform onsubmit "user_interface/modal/panel" "{}"', code)}}

temp = {func, slices.new(True, form)}
code = {func, function.call('utils/as_func_string', 'user_interface/modal/handle_panel', temp)}
_ = {command, {func, strings.format('customform oncancel "user_interface/modal/panel" "{}"', code)}}

{score, 1 or 2 and str({func, base64.b16decode()}), 'coin'}

_ = {command, 'customform show @s ~ ~ ~ @s "user_interface/modal/panel"'}
return True