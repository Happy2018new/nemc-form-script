/*
user_interface/modal/edit_input(
  form_name: str,
  element_index: int,
) -> bool
*/





form_name = {func, tuple.get(args, 0)}
element_index = {func, tuple.get(args, 1)}





level_id = {func, object.deref({func, world.GetLevelId()})}
storage = {func, entity.GetExtraData(level_id, 'form_ui_storage')}
modal = {func, maps.ptr_get(storage, {func, object.ref('modal')})}
form_data = {func, maps.ptr_get(modal, {func, object.ref(form_name)})}
content = {func, maps.ptr_get(form_data, {func, object.ref('content')})}
element = {func, slices.ptr_get(content, element_index)}





text = {func, maps.get(element, 'text')}
text = {func, function.call('utils/as_code_string', text)}
cmd = {func, strings.format('editinput "user_interface/modal/edit_input" 2 default "return {}"', text)}
_ = {command, cmd}



optional_place_holder = {func, maps.ptr_get(element, {func, object.ref('optional_place_holder')})}
condition = {func, maps.get(optional_place_holder, 'condition')}
payload = {func, maps.get(optional_place_holder, 'payload')}

condition = {func, function.call('utils/as_code_string', condition)}
cmd = {func, strings.format('editinput "user_interface/modal/edit_input" 5 default "return {}"', condition)}
_ = {command, cmd}

payload = {func, function.call('utils/as_code_string', payload)}
cmd = {func, strings.format('editinput "user_interface/modal/edit_input" 6 default "return {}"', payload)}
_ = {command, cmd}



optional_default = {func, maps.ptr_get(element, {func, object.ref('optional_default')})}
condition = {func, maps.get(optional_default, 'condition')}
payload = {func, maps.get(optional_default, 'payload')}

condition = {func, function.call('utils/as_code_string', condition)}
cmd = {func, strings.format('editinput "user_interface/modal/edit_input" 9 default "return {}"', condition)}
_ = {command, cmd}

payload = {func, function.call('utils/as_code_string', payload)}
cmd = {func, strings.format('editinput "user_interface/modal/edit_input" 10 default "return {}"', payload)}
_ = {command, cmd}



optional_tooltip = {func, maps.ptr_get(element, {func, object.ref('optional_tooltip')})}
condition = {func, maps.get(optional_tooltip, 'condition')}
payload = {func, maps.get(optional_tooltip, 'payload')}

condition = {func, function.call('utils/as_code_string', condition)}
cmd = {func, strings.format('editinput "user_interface/modal/edit_input" 13 default "return {}"', condition)}
_ = {command, cmd}

payload = {func, function.call('utils/as_code_string', payload)}
cmd = {func, strings.format('editinput "user_interface/modal/edit_input" 14 default "return {}"', payload)}
_ = {command, cmd}





length = {func, form.modal_form_length('user_interface/modal/edit_input')}
_ = {command, 'editmodalform "user_interface/modal/edit_input" sub discard 19 ' + str(length)}

onsubmit = {func, maps.ptr_get(element, {func, object.ref('onsubmit')})}
length = {func, slices.length(onsubmit)}

if {func, math.mod(length, 3)} == 0:
  final = length + 3
else:
  final = 3*int(length/3) + 3
fi

for i, final:
  _ = {command, 'editmodalform "user_interface/modal/edit_input" append input'}
  _ = {command, 'editmodalform "user_interface/modal/edit_input" append toggle'}

  _ = {command, {func, strings.format('editinput "user_interface/modal/edit_input" {} text "return \'要执行的指令\'"', 19+2*i)}}
  _ = {command, {func, strings.format('editinput "user_interface/modal/edit_input" {} placeholder "return \'say 玩家输入了 [ref]\'"', 19+2*i)}}
  _ = {command, {func, strings.format('editinput "user_interface/modal/edit_input" {} tooltip "return \'§b[ref]§r 表示玩家输入的内容。\'"', 19+2*i)}}
  _ = {command, {func, strings.format('edittoggle "user_interface/modal/edit_input" {} text "return \'条件制约\'"', 20+2*i)}}
  _ = {command, {func, strings.format('edittoggle "user_interface/modal/edit_input" {} tooltip "return \'要求该指令只会在上一个指令成功时才执行。\'"', 20+2*i)}}

  if i < length:
    ptr = {func, slices.ptr_get(onsubmit, i)}

    payload = {func, maps.get(ptr, 'payload')}
    payload = {func, function.call('utils/as_code_string', payload)}
    _ = {command, {func, strings.format('editinput "user_interface/modal/edit_input" {} default "return {}"', 19+2*i, payload)}}

    condition = {func, maps.get(ptr, 'condition')}
    if condition:
      _ = {command, {func, strings.format('edittoggle "user_interface/modal/edit_input" {} default "return True"', 20+2*i)}}
    fi
  fi
rof





temp = {func, slices.new(False, form_name, element_index, final)}
code = {func, function.call('utils/as_func_string', 'user_interface/modal/handle_edit_input', temp)}
_ = {command, {func, strings.format('customform onsubmit "user_interface/modal/edit_input" "{}"', code)}}

temp = {func, slices.new(True, form_name, element_index, final)}
code = {func, function.call('utils/as_func_string', 'user_interface/modal/handle_edit_input', temp)}
_ = {command, {func, strings.format('customform oncancel "user_interface/modal/edit_input" "{}"', code)}}





_ = {command, 'customform show @s ~ ~ ~ @s "user_interface/modal/edit_input"'}
return True