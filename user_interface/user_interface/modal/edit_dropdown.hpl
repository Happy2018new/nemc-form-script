/*
user_interface/modal/edit_dropdown(
  form_name: str,
  element_index: int,
) -> bool
*/





form_name = {func, tuple.get(args, 0)}
element_index = {func, tuple.get(args, 1)}





level_id = {func, object.deref({func, world.GetLevelId()})}
storage = {func, entity.GetExtraData(level_id, 'form_ui_storage')}
modal = {func, maps.ptr_get(storage, {func, object.ref('modal')})}
form_data = {func, maps.ptr_get(modal, {func, object.ref(form_name)})}
content = {func, maps.ptr_get(form_data, {func, object.ref('content')})}
element = {func, slices.ptr_get(content, element_index)}





text = {func, maps.get(element, 'text')}
text = {func, function.call('utils/as_code_string', text)}
cmd = {func, strings.format('editinput "user_interface/modal/edit_dropdown" 2 default "return {}"', text)}
_ = {command, cmd}



default = {func, maps.get(element, 'default')}
default = {func, function.call('utils/as_code_string', default)}
cmd = {func, strings.format('editinput "user_interface/modal/edit_dropdown" 5 default "return {}"', default)}
_ = {command, cmd}



optional_tooltip = {func, maps.ptr_get(element, {func, object.ref('optional_tooltip')})}
condition = {func, maps.get(optional_tooltip, 'condition')}
payload = {func, maps.get(optional_tooltip, 'payload')}

condition = {func, function.call('utils/as_code_string', condition)}
cmd = {func, strings.format('editinput "user_interface/modal/edit_dropdown" 8 default "return {}"', condition)}
_ = {command, cmd}

payload = {func, function.call('utils/as_code_string', payload)}
cmd = {func, strings.format('editinput "user_interface/modal/edit_dropdown" 9 default "return {}"', payload)}
_ = {command, cmd}





options = {func, maps.ptr_get(element, {func, object.ref('options')})}
length = {func, slices.length(options)}

if {func, math.mod(length, 3)} == 0:
  final_opts = length + 3
else:
  final_opts = 3*int(length/3) + 3
fi

for i, final_opts:
  _ = {command, {func, strings.format('editmodalform "user_interface/modal/edit_dropdown" insert {} input', 14+i)}}

  _ = {command, {func, strings.format('editinput "user_interface/modal/edit_dropdown" {} text "return \'下拉框选项\'"', 14+i)}}
  _ = {command, {func, strings.format('editinput "user_interface/modal/edit_dropdown" {} placeholder "return \'我叫 $-$@s$ 且我有 #-#@s#金币# 个金币\'"', 14+i)}}
  _ = {command, {func, strings.format('editinput "user_interface/modal/edit_dropdown" {} tooltip "return \'§b$条件(选择器)$内容(选择器/纯文本)$§r\n  表示实体名或纯文本(用“§e-§r”代表无需条件)。\n§b#条件(选择器)#目标#记分板#§r\n  表示分数(用“§e-§r”代表无需条件)。\n§b$$§r, §b##§r 和 §b\\n§r\n  分别表示 §e$§r, §e#§r 和 §e换行§r。\'"', 14+i)}}

  if i < length:
    opt = {func, slices.get(options, i)}
    opt = {func, function.call('utils/as_code_string', opt)}
    cmd = {func, strings.format('editinput "user_interface/modal/edit_dropdown" {} default "return {}"', 14+i, opt)}
    _ = {command, cmd}
  fi
rof





onsubmit = {func, maps.ptr_get(element, {func, object.ref('onsubmit')})}
length = {func, slices.length(onsubmit)}

if {func, math.mod(length, 3)} == 0:
  final_cmds = length + 3
else:
  final_cmds = 3*int(length/3) + 3
fi

for i, final_cmds:
  _ = {command, {func, strings.format('editmodalform "user_interface/modal/edit_dropdown" append input', 18+final_opts+2*i)}}
  _ = {command, {func, strings.format('editmodalform "user_interface/modal/edit_dropdown" append toggle', 19+final_opts+2*i)}}

  _ = {command, {func, strings.format('editinput "user_interface/modal/edit_dropdown" {} text "return \'要执行的指令\'"', 18+final_opts+2*i)}}
  _ = {command, {func, strings.format('editinput "user_interface/modal/edit_dropdown" {} placeholder "return \'scoreboard players set @s result [ref]\'"', 18+final_opts+2*i)}}
  _ = {command, {func, strings.format('editinput "user_interface/modal/edit_dropdown" {} tooltip "return \'§b[ref]§r 表示玩家所选中之选项的索引。\'"', 18+final_opts+2*i)}}
  _ = {command, {func, strings.format('edittoggle "user_interface/modal/edit_dropdown" {} text "return \'条件制约\'"', 19+final_opts+2*i)}}
  _ = {command, {func, strings.format('edittoggle "user_interface/modal/edit_dropdown" {} tooltip "return \'要求该指令只会在上一个指令成功时才执行。\'"', 19+final_opts+2*i)}}

  if i < length:
    ptr = {func, slices.ptr_get(onsubmit, i)}

    payload = {func, maps.get(ptr, 'payload')}
    payload = {func, function.call('utils/as_code_string', payload)}
    _ = {command, {func, strings.format('editinput "user_interface/modal/edit_dropdown" {} default "return {}"', 18+final_opts+2*i, payload)}}

    condition = {func, maps.get(ptr, 'condition')}
    if condition:
      _ = {command, {func, strings.format('edittoggle "user_interface/modal/edit_dropdown" {} default "return True"', 19+final_opts+2*i)}}
    fi
  fi
rof





cmd = {func, strings.format('editmodalform "user_interface/modal/edit_dropdown" title "return \'下拉框 ({})\'"', element_index)}
_ = {command, cmd}

temp = {func, slices.new(False, form_name, element_index, final_opts, final_cmds)}
code = {func, function.call('utils/as_func_string', 'user_interface/modal/handle_edit_dropdown', temp)}
_ = {command, {func, strings.format('customform onsubmit "user_interface/modal/edit_dropdown" "{}"', code)}}

temp = {func, slices.new(True, form_name, element_index, final_opts, final_cmds)}
code = {func, function.call('utils/as_func_string', 'user_interface/modal/handle_edit_dropdown', temp)}
_ = {command, {func, strings.format('customform oncancel "user_interface/modal/edit_dropdown" "{}"', code)}}





_ = {command, 'customform show @s ~ ~ ~ @s "user_interface/modal/edit_dropdown"'}
_ = {command, {func, strings.format('editmodalform "user_interface/modal/edit_dropdown" sub discard {} {}', 18+final_opts, 18+final_opts+2*final_cmds)}}
_ = {command, {func, strings.format('editmodalform "user_interface/modal/edit_dropdown" sub discard {} {}', 14, 14+final_opts)}}
return True