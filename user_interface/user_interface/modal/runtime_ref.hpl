/*
user_interface/modal/runtime_ref(
  raw_command: str,
  element_type: str,
  element_index: int,
) -> bool
*/



raw_command = {func, tuple.get(args, 0)}
element_type = {func, tuple.get(args, 1)}
element_index = {func, tuple.get(args, 2)}



if element_type == 'input':
  temp = {ref, str, element_index}
  if {func, strings.length(temp)} > 1024:
    temp = {func, strings.sub(temp, 0, 1024)}
  fi

  for _, 2048:
    if {func, strings.find(temp, 'ref')} == -1 and {func, strings.find(temp, 'json-ref')} == -1:
      break
    fi
    temp = {func, strings.replace(temp, '[ref]', '')}
    temp = {func, strings.replace(temp, '[json-ref]', '')}
  rof

  raw_command = {func, strings.replace(raw_command, '[ref]', temp)}
  raw_command = {func, strings.replace(raw_command, '[json-ref]', {func, json.fast_dumps(temp)})}
  return {command, raw_command} > 0
fi



if element_type == 'toggle':
  if {ref, bool, element_index}:
    raw_command = {func, strings.replace(raw_command, '[ref]', '0')}
    return {command, raw_command} > 0
  else:
    raw_command = {func, strings.replace(raw_command, '[ref]', '1')}
    return {command, raw_command} > 0
  fi
elif element_type == 'dropdown' or element_type == 'slider' or element_type == 'step_slider':
  temp = str({ref, int, element_index})
  raw_command = {func, strings.replace(raw_command, '[ref]', temp)}
  return {command, raw_command} > 0
fi



err = 'user_interface/modal/runtime_ref: Unsupported element type; element_type = ' + element_type
_ = {func, function.panic(err)}