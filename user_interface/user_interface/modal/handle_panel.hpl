/*
user_interface/modal/handle_panel(
  is_cancel: bool,
  form: str,
) -> bool

FORM_TYPE_LONG = 0
FORM_TYPE_POPUP = 1
FORM_TYPE_MODAL = 2
*/



is_cancel = {func, tuple.get(args, 0)}
form = {func, tuple.get(args, 1)}



if is_cancel:
  if {ref, int, -1} != 2:
    _ = {func, function.call('user_interface/panel')}
  fi
  return True
fi



index = {ref, int, -1}
if index == 0:
  _ = {func, function.call('user_interface/modal/preview', form)}
elif index == 1:
  _ = {func, function.call('user_interface/modal/add', form, -1)}
elif index == 2:
  _ = {func, function.call('user_interface/modal/insert', form)}
elif index == 3:
  _ = {func, function.call('user_interface/modal/edit', form)}
elif index == 4:
  _ = {func, function.call('user_interface/modal/remove', form)}
elif index == 5:
  _ = {func, function.call('user_interface/modal/title', form)}
elif index == 6:
  _ = {func, function.call('user_interface/cancel', form, 2)}
elif index == 7:
  _ = {func, function.call('user_interface/panel')}
fi



return True