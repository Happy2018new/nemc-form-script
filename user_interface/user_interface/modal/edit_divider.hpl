// user_interface/modal/edit_divider(form: str) -> bool



form = {func, tuple.get(args, 0)}



temp = {func, slices.new(False, form)}
code = {func, function.call('utils/as_func_string', 'user_interface/modal/handle_edit_divider', temp)}
_ = {command, {func, strings.format('customform onsubmit "user_interface/modal/edit_divider" "{}"', code)}}

temp = {func, slices.new(True, form)}
code = {func, function.call('utils/as_func_string', 'user_interface/modal/handle_edit_divider', temp)}
_ = {command, {func, strings.format('customform oncancel "user_interface/modal/edit_divider" "{}"', code)}}



_ = {command, 'customform show @s ~ ~ ~ @s "user_interface/modal/edit_divider"'}
return True