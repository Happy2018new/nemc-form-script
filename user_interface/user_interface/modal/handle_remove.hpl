/*
user_interface/modal/handle_remove(
  is_cancel: bool,
  form: str,
  length: int,
) -> bool
*/



is_cancel = {func, tuple.get(args, 0)}
form = {func, tuple.get(args, 1)}
length = {func, tuple.get(args, 2)}



if is_cancel:
  if {ref, int, -1} != 2:
    _ = {func, function.call('user_interface/modal/panel', form)}
  fi
  return True
fi



index = {ref, int, -1}
if index == length:
  _ = {func, function.call('user_interface/modal/panel', form)}
else:
  _ = {func, function.call('user_interface/storage/modal/remove_element', form, index)}
  _ = {func, function.call('user_interface/modal/remove', form)}
fi





return True