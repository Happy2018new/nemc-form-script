/*
user_interface/modal/handle_add(
  is_cancel: bool,
  form: str,
  index: int,
) -> bool

ELEMENT_TYPE_LABEL = 0
ELEMENT_TYPE_HEADER = 1
ELEMENT_TYPE_DIVIDER = 2
ELEMENT_TYPE_INPUT = 3
ELEMENT_TYPE_TOGGLE = 4
ELEMENT_TYPE_DROPDOWN = 5
ELEMENT_TYPE_SLIDER = 6
ELEMENT_TYPE_STEP_SLIDER = 7
*/



is_cancel = {func, tuple.get(args, 0)}
form = {func, tuple.get(args, 1)}
index = {func, tuple.get(args, 2)}



if is_cancel:
  if {ref, int, -1} != 2:
    if index == -1:
      _ = {func, function.call('user_interface/modal/panel', form)}
    else:
      _ = {func, function.call('user_interface/modal/insert', form)}
    fi
  fi
  return True
fi



selected = {ref, int, -1}
if selected == 0:
  _ = {func, function.call('user_interface/storage/modal/add_element', form, 0, index)}
  _ = {func, function.call('user_interface/modal/add_after', form, index)}
elif selected == 1:
  _ = {func, function.call('user_interface/storage/modal/add_element', form, 1, index)}
  _ = {func, function.call('user_interface/modal/add_after', form, index)}
elif selected == 2:
  _ = {func, function.call('user_interface/storage/modal/add_element', form, 2, index)}
  if index == -1:
    _ = {func, function.call('user_interface/modal/add', form, -1)}
  else:
    _ = {func, function.call('user_interface/modal/insert', form)}
  fi
elif selected == 3:
  _ = {func, function.call('user_interface/storage/modal/add_element', form, 3, index)}
  _ = {func, function.call('user_interface/modal/add_after', form, index)}
elif selected == 4:
  _ = {func, function.call('user_interface/storage/modal/add_element', form, 4, index)}
  _ = {func, function.call('user_interface/modal/add_after', form, index)}
elif selected == 5:
  _ = {func, function.call('user_interface/storage/modal/add_element', form, 5, index)}
  _ = {func, function.call('user_interface/modal/add_after', form, index)}
elif selected == 6:
  _ = {func, function.call('user_interface/storage/modal/add_element', form, 6, index)}
  _ = {func, function.call('user_interface/modal/add_after', form, index)}
elif selected == 7:
  _ = {func, function.call('user_interface/storage/modal/add_element', form, 7, index)}
  _ = {func, function.call('user_interface/modal/add_after', form, index)}
elif selected == 8:
  if index == -1:
    _ = {func, function.call('user_interface/modal/panel', form)}
  else:
    _ = {func, function.call('user_interface/modal/insert', form)}
  fi
fi



return True