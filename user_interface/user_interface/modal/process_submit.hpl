/*
user_interface/modal/process_submit(
  form_name: str,
  content: ptr@slice[map[str, Any]],
  is_debug: bool,
) -> bool
*/





form_name = {func, tuple.get(args, 0)}
content = {func, tuple.get(args, 1)}
is_debug = {func, tuple.get(args, 2)}





result = ''
submit_ptr = {func, object.ref('onsubmit')}



for index, {func, slices.length(content)}:
  value = {func, slices.ptr_get(content, index)}
  if not {func, maps.exist(value, 'onsubmit')}:
    continue
  fi



  onsubmit = {func, maps.ptr_get(value, submit_ptr)}
  element_type = {func, maps.get(value, 'type')}

  length = {func, slices.length(onsubmit)}
  if length == 0:
    continue
  else:
    result = result + 'cond = False | '
  fi



  for ind, length:
    val = {func, slices.ptr_get(onsubmit, ind)}
    condition = {func, maps.get(val, 'condition')}
    payload = {func, maps.get(val, 'payload')}

    temp = {func, slices.new(payload, element_type, index)}
    temp = {func, function.call('utils/as_func_string', 'user_interface/modal/runtime_ref', temp)}
    temp = {func, strings.sub(temp, 7, {func, strings.length(temp)})}

    if condition:
      result = result + {func, strings.format('if cond: | cond = {} | fi | ', temp)}
    else:
      result = result + {func, strings.format('cond = {} | ', temp)}
    fi
  rof
rof



if is_debug:
  // back to the main edit panel of this modal form
fi





result = {func, strings.strip(result)}
result = {func, strings.rstrip(result, '|')}
format = {func, json.fast_dumps(form_name)}

_ = {command, {func, strings.format('customform onsubmit {} "{}"', format, result)}}
_ = {command, {func, strings.format('customform save {}', format)}}

return True