/*
user_interface/modal/preview(form: str) -> bool

FORM_TYPE_LONG = 0
FORM_TYPE_POPUP = 1
FORM_TYPE_MODAL = 2
*/



form = {func, tuple.get(args, 0)}
format = {func, json.fast_dumps(form)}



level_id = {func, object.deref({func, world.GetLevelId()})}
storage = {func, entity.GetExtraData(level_id, 'form_ui_storage')}
modal = {func, maps.ptr_get(storage, {func, object.ref('modal')})}
form_data = {func, maps.ptr_get(modal, {func, object.ref(form)})}
content = {func, maps.ptr_get(form_data, {func, object.ref('content')})}
oncancel = {func, maps.ptr_get(form_data, {func, object.ref('oncancel')})}



_ = {func, function.call('user_interface/modal/process_submit', form, content, True)}
_ = {func, function.call('user_interface/process_cancel', form, 2, oncancel, True)}
_ = {command, {func, strings.format('customform show @s ~ ~ ~ @s {}', format)}}
_ = {func, function.call('user_interface/modal/process_submit', form, content, False)}
_ = {func, function.call('user_interface/process_cancel', form, 2, oncancel, False)}



return True