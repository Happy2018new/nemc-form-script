/*
user_interface/modal/add_after(
  form: str,
  index: int,
) -> bool
*/



form = {func, tuple.get(args, 0)}
index = {func, tuple.get(args, 1)}



temp = {func, slices.new(False, form, index)}
code = {func, function.call('utils/as_func_string', 'user_interface/modal/handle_add_after', temp)}
_ = {command, {func, strings.format('customform onsubmit "user_interface/modal/add_after" "{}"', code)}}

temp = {func, slices.new(True, form, index)}
code = {func, function.call('utils/as_func_string', 'user_interface/modal/handle_add_after', temp)}
_ = {command, {func, strings.format('customform oncancel "user_interface/modal/add_after" "{}"', code)}}



_ = {command, 'customform show @s ~ ~ ~ @s "user_interface/modal/add_after"'}
return True