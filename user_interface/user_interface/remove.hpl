/*
user_interface/remove(form_type: int) -> bool

callback(
  submit_type: int,
  options: ptr@slice[text: str | tuple[text: str, icon: str, ...]],
  extra: ptr@map
  selected: int,
) -> int | bool | float | str

FORM_TYPE_LONG = 0
FORM_TYPE_POPUP = 1
FORM_TYPE_MODAL = 2

SUBMIT_TYPE_SUBMIT = 1
SUBMIT_TYPE_BACK = 2
SUBMIT_TYPE_CANCEL = 3
*/



form_type = {func, tuple.get(args, 0)}



options = {func, function.call('user_interface/storage/list_form', form_type)}
_ = {func, object.finalise(options)}
extra = {func, maps.new(False, 'form_type', form_type)}
_ = {func, function.call('page_split/select_panel', '移除已有表单', '请选择您要移除的表单。', options, extra, 1, 'user_interface/remove_callback')}



return True