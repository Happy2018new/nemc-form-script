/*
user_interface/cancel_specific(
  form_name: str,
  form_type: str,
  edit_type: int,
) -> bool

FORM_TYPE_LONG = 0
FORM_TYPE_POPUP = 1
FORM_TYPE_MODAL = 2

EDIT_TYPE_EDIT_NORMAL_CANCEL = 0
EDIT_TYPE_EDIT_BUSY_CANCEL = 1
EDIT_TYPE_EDIT_EXIT_CANCEL = 2
*/





form_name = {func, tuple.get(args, 0)}
form_type = {func, tuple.get(args, 1)}
edit_type = {func, tuple.get(args, 2)}





level_id = {func, object.deref({func, world.GetLevelId()})}
storage = {func, entity.GetExtraData(level_id, 'form_ui_storage')}

if form_type == 0:
  key_ptr = {func, object.ref('long')}
elif form_type == 1:
  key_ptr = {func, object.ref('popup')}
elif form_type == 2:
  key_ptr = {func, object.ref('modal')}
else:
  err = 'user_interface/cancel_specific: Unsupported form type; form_type = ' + str(form_type)
  _ = {func, function.panic(err)}
fi

forms = {func, maps.ptr_get(storage, key_ptr)}
form_data = {func, maps.ptr_get(forms, {func, object.ref(form_name)})}
oncancel = {func, maps.ptr_get(form_data, {func, object.ref('oncancel')})}

if edit_type == 0:
  key_ptr = {func, object.ref('normal')}
elif edit_type == 1:
  key_ptr = {func, object.ref('busy')}
elif edit_type == 2:
  key_ptr = {func, object.ref('exit')}
else:
  err = 'user_interface/cancel_specific: Unsupported edit type; edit_type = ' + str(edit_type)
  _ = {func, function.panic(err)}
fi

cancel_data = {func, maps.ptr_get(oncancel, key_ptr)}





if edit_type == 0:
  panel = 'user_interface/cancel_normal'
  start = 4
elif edit_type == 1:
  panel = 'user_interface/cancel_busy'
  start = 5
elif edit_type == 2:
  panel = 'user_interface/cancel_exit'
  start = 5
else:
  err = 'user_interface/cancel_specific: Unsupported edit type; edit_type = ' + str(edit_type)
  _ = {func, function.panic(err)}
fi

length = {func, form.modal_form_length(panel)}
_ = {command, {func, strings.format('editmodalform "{}" sub discard {} {}', panel, start, length)}}

length = {func, slices.length(cancel_data)}
if {func, math.mod(length, 3)} == 0:
  final = length + 3
else:
  final = 3*int(length/3) + 3
fi

for i, final:
  _ = {command, {func, strings.format('editmodalform "{}" append input', panel)}}
  _ = {command, {func, strings.format('editmodalform "{}" append toggle', panel)}}

  _ = {command, {func, strings.format('editinput "{}" {} text "return \'要执行的指令\'"', panel, start+2*i)}}
  _ = {command, {func, strings.format('edittoggle "{}" {} text "return \'条件制约\'"', panel, start+1+2*i)}}
  _ = {command, {func, strings.format('edittoggle "{}" {} tooltip "return \'要求该指令只会在上一个指令成功时才执行。\'"', panel, start+1+2*i)}}

  if i < length:
    ptr = {func, slices.ptr_get(cancel_data, i)}

    payload = {func, maps.get(ptr, 'payload')}
    payload = {func, function.call('utils/as_code_string', payload)}
    _ = {command, {func, strings.format('editinput "{}" {} default "return {}"', panel, start+2*i, payload)}}

    condition = {func, maps.get(ptr, 'condition')}
    if condition:
      _ = {command, {func, strings.format('edittoggle "{}" {} default "return True"', panel, start+1+2*i)}}
    fi
  fi
rof





temp = {func, slices.new(False, form_name, form_type, edit_type, final)}
code = {func, function.call('utils/as_func_string', 'user_interface/handle_cancel_specific', temp)}
_ = {command, {func, strings.format('customform onsubmit "{}" "{}"', panel, code)}}

temp = {func, slices.new(True, form_name, form_type, edit_type, final)}
code = {func, function.call('utils/as_func_string', 'user_interface/handle_cancel_specific', temp)}
_ = {command, {func, strings.format('customform oncancel "{}" "{}"', panel, code)}}





_ = {command, {func, strings.format('customform show @s ~ ~ ~ @s "{}"', panel)}}
return True