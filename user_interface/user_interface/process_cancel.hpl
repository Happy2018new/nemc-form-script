/*
user_interface/process_cancel(
  form_name: str,
  form_type: int,
  oncancel: ptr@map[str, slice[map[str, Any]]],
  is_debug: bool,
) -> bool

FORM_TYPE_LONG = 0
FORM_TYPE_POPUP = 1
FORM_TYPE_MODAL = 2
*/





form_name = {func, tuple.get(args, 0)}
form_type = {func, tuple.get(args, 1)}
oncancel = {func, tuple.get(args, 2)}
is_debug = {func, tuple.get(args, 3)}





result = 'cond = False | '
result = result + 'reason = {ref, int, -1} | '
keys = {func, maps.keys(oncancel)}



for index, {func, slices.length(keys)}:
  key = {func, slices.get(keys, index)}
  value = {func, maps.ptr_get(oncancel, {func, object.ref(key)})}



  length = {func, slices.length(value)}
  if length == 0:
    continue
  fi

  if key == 'normal':
    result = result + 'if reason == 0: | '
  elif key == 'busy':
    result = result + 'if reason == 1: | '
  elif key == 'exit':
    result = result + 'if reason == 2: | '
  else:
    _ = {func, function.panic('unreachable')}
  fi



  for ind, length:
    val = {func, slices.ptr_get(value, ind)}
    condition = {func, maps.get(val, 'condition')}
    payload = {func, maps.get(val, 'payload')}

    temp = '{command, '
    temp = temp + {func, function.call('utils/as_code_string', payload)}
    temp = temp + '} > 0'

    if condition:
      result = result + {func, strings.format('if cond: | cond = {} | fi | ', temp)}
    else:
      result = result + {func, strings.format('cond = {} | ', temp)}
    fi
  rof



  result = result + 'fi | '
rof



if is_debug:
  if form_type == 0:
    temp = {func, slices.new(form_name)}
    temp = {func, function.call('utils/as_func_string', 'user_interface/long/panel', temp)}
    temp = {func, strings.sub(temp, 7, {func, strings.length(temp)})}
  elif form_type == 1:
    temp = {func, slices.new(form_name)}
    temp = {func, function.call('utils/as_func_string', 'user_interface/popup/panel', temp)}
    temp = {func, strings.sub(temp, 7, {func, strings.length(temp)})}
  elif form_type == 2:
    temp = {func, slices.new(form_name)}
    temp = {func, function.call('utils/as_func_string', 'user_interface/modal/panel', temp)}
    temp = {func, strings.sub(temp, 7, {func, strings.length(temp)})}
  else:
    err = 'user_interface/process_cancel: Unsupported form type; form_type = ' + str(form_type)
    _ = {func, function.panic(err)}
  fi
  result = result + {func, strings.format('if reason != 2: | _ = {} | fi | ', temp)}
fi





result = {func, strings.strip(result)}
result = {func, strings.rstrip(result, '|')}
format = {func, json.fast_dumps(form_name)}

_ = {command, {func, strings.format('customform oncancel {} "{}"', format, result)}}
_ = {command, {func, strings.format('customform save {}', format)}}

return True