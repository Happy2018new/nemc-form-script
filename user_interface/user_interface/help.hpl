// user_interface/help() -> bool



temp = {func, slices.new(False)}
code = {func, function.call('utils/as_func_string', 'user_interface/handle_help', temp)}
_ = {command, {func, strings.format('customform onsubmit "user_interface/help" "{}"', code)}}

temp = {func, slices.new(True)}
code = {func, function.call('utils/as_func_string', 'user_interface/handle_help', temp)}
_ = {command, {func, strings.format('customform oncancel "user_interface/help" "{}"', code)}}



_ = {command, 'customform show @s ~ ~ ~ @s "user_interface/help"'}
return True