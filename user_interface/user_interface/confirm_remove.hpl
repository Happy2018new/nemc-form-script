/*
user_interface/confirm_remove(
  form_name: str,
  form_type: int,
) -> bool

FORM_TYPE_LONG = 0
FORM_TYPE_POPUP = 1
FORM_TYPE_MODAL = 2
*/



form_name = {func, tuple.get(args, 0)}
form_type = {func, tuple.get(args, 1)}



temp = {func, slices.new(False, form_name, form_type)}
code = {func, function.call('utils/as_func_string', 'user_interface/handle_confirm_remove', temp)}
_ = {command, {func, strings.format('customform onsubmit "user_interface/confirm_remove" "{}"', code)}}

temp = {func, slices.new(True, form_name, form_type)}
code = {func, function.call('utils/as_func_string', 'user_interface/handle_confirm_remove', temp)}
_ = {command, {func, strings.format('customform oncancel "user_interface/confirm_remove" "{}"', code)}}



_ = {command, 'customform show @s ~ ~ ~ @s "user_interface/confirm_remove"'}
return True