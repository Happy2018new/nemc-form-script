/*
user_interface/handle_pivot(
  is_cancel: bool,
  edit_type: int,
) -> bool

EDIT_TYPE_ADD_FORM = 0
EDIT_TYPE_EDIT_FORM = 1
EDIT_TYPE_REMOVE_FORM = 2
*/



is_cancel = {func, tuple.get(args, 0)}
edit_type = {func, tuple.get(args, 1)}



if is_cancel:
  if {ref, int, -1} != 2:
    _ = {func, function.call('user_interface/panel')}
  fi
  return True
fi



index = {ref, int, -1}
if index != 3:
  if edit_type == 0:
    _ = {func, function.call('user_interface/add', index)}
  elif edit_type == 1:
    _ = {func, function.call('user_interface/edit', index)}
  elif edit_type == 2:
    _ = {func, function.call('user_interface/remove', index)}
  fi
else:
  _ = {func, function.call('user_interface/panel')}
fi



return True