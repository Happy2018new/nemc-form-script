/*
user_interface/handle_add(
  is_cancel: bool,
  form_type: int,
) -> bool

FORM_TYPE_LONG = 0
FORM_TYPE_POPUP = 1
FORM_TYPE_MODAL = 2
*/



is_cancel = {func, tuple.get(args, 0)}
form_type = {func, tuple.get(args, 1)}



if is_cancel:
  if {ref, int, -1} != 2:
    _ = {func, function.call('user_interface/panel')}
  fi
  return True
else:
  form_name = {ref, str, 1}
fi



if form_type == 0:
  success = {command, 'customform add ' + {func, json.fast_dumps(form_name)} + ' long'} > 0
elif form_type == 1:
  success = {command, 'customform add ' + {func, json.fast_dumps(form_name)} + ' popup'} > 0
elif form_type == 2:
  success = {command, 'customform add ' + {func, json.fast_dumps(form_name)} + ' modal'} > 0
else:
  err = 'user_interface/handle_add: Unsupported form type; form_type = ' + str(form_type)
  _ = {func, function.panic(err)}
fi
if success:
  _ = {func, function.call('user_interface/storage/init_form', form_name, form_type)}
fi



_ = {func, function.call('user_interface/add_after', success, form_name, form_type)}
return True