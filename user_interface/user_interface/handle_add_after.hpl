/*
user_interface/handle_add_after(
  is_cancel: bool,
  success: bool,
  form_name: str,
  form_type: int,
) -> bool

FORM_TYPE_LONG = 0
FORM_TYPE_POPUP = 1
FORM_TYPE_MODAL = 2
*/



is_cancel = {func, tuple.get(args, 0)}
success = {func, tuple.get(args, 1)}
form_name = {func, tuple.get(args, 2)}
form_type = {func, tuple.get(args, 3)}



if is_cancel:
  if {ref, int, -1} != 2:
    _ = {func, function.call('user_interface/panel')}
  fi
  return True
fi



if success:
  if not {ref, bool, -1}:
    _ = {func, function.call('user_interface/panel')}
    return True
  fi
else:
  _ = {func, function.call('user_interface/add', form_type)}
  return True
fi



if form_type == 0:
  _ = {func, function.call('user_interface/long/panel', form_name)}
elif form_type == 1:
  _ = {func, function.call('user_interface/popup/panel', form_name)}
elif form_type == 2:
  _ = {func, function.call('user_interface/modal/panel', form_name)}
else:
  err = 'user_interface/handle_add_after: Unsupported form type; form_type = ' + str(form_type)
  _ = {func, function.panic(err)}
fi



return True