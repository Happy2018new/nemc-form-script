/*
utils/dropdown_selector(
  menu_name: str,
  dropdown_index: int,
  target: str,
) -> ptr@slice[str]
*/





menu_name = {func, tuple.get(args, 0)}
dropdown_index = {func, tuple.get(args, 1)}
target = {func, tuple.get(args, 2)}





format_name = {func, json.fast_dumps(menu_name)}
dropdown_length = {func, form.dropdown_length(menu_name, dropdown_index)}
cmd = {func, strings.format('editdropdown {} {} sub discard 0 {}', format_name, dropdown_index, dropdown_length)}
_ = {command, cmd}





executor = {func, command.get_executor()}
selected = {func, entity.GetEntitiesBySelector(executor, target)}
length = {func, slices.length(selected)}
name_with_id = {func, slices.new()}

for index, length:
  value = {func, slices.get(selected, index)}

  _ = {func, command.set_executor(value)}
  name = {selector, '@s'}
  _ = {func, command.set_executor(executor)}

  pair = {func, tuple.new(name, value)}
  _ = {func, slices.ptr_append(name_with_id, pair)}
rof

_ = {func, slices.sort(name_with_id)}





for index, length:
  value = {func, slices.ptr_get(name_with_id, index)}
  value = {func, tuple.get(value, 0)}
  value = {func, function.call('utils/as_code_string', value)}
  cmd = {func, strings.format('editdropdown {} {} append \"return {}\"', format_name, dropdown_index, value)}
  _ = {command, cmd}
rof





result = {func, slices.new()}

for index, length:
  value = {func, slices.ptr_get(name_with_id, index)}
  value = {func, tuple.get(value, 1)}
  _ = {func, slices.append(result, value)}
rof

_ = {func, object.pin(result)}
return result