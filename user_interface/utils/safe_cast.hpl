/*
utils/safe_cast(
  from: int | bool | float | str,
  to: int,
) -> int | bool | float | str

ENUM_TO_INT = 0
ENUM_TO_BOOL = 1
ENUM_TO_FLOAT = 2
ENUM_TO_STR = 3
*/



from = {func, tuple.get(args, 0)}
from = {func, object.ref(from)}
to = {func, tuple.get(args, 1)}



if to == 0:
  ptr = {func, reflect.cast(from, {func, object.ref(0)})}
  if ptr == 0:
    return 0
  fi
elif to == 1:
  ptr = {func, reflect.cast(from, {func, object.ref(False)})}
  if ptr == 0:
    return False
  fi
elif to == 2:
  ptr = {func, reflect.cast(from, {func, object.ref(0.0)})}
  if ptr == 0:
    return 0.0
  fi
elif to == 3:
  ptr = {func, reflect.cast(from, {func, object.ref('')})}
  if ptr == 0:
    return ''
  fi
else:
  err = 'utils/safe_cast: Unexpected "to" was given; to = ' + str(to)
  _ = {func, function.panic(err)}
fi



return {func, object.deref(ptr)}